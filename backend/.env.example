# =============================================================================
# Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================
#
# PRIORITY ORDER:
#   1. Environment variables (Docker/CI — highest priority)
#   2. .env file values (local development)
#   3. Default values in app/core/config.py (fallback)
#
# SECRETS:
#   Fields marked [SECRET] use Pydantic SecretStr.
#   They will NOT appear in logs, tracebacks, or repr() output.
#
# AUTHENTICATION:
#   JWT_SECRET_KEY is required in every environment because auth is active.
#   Production also refuses to start if MONGODB_URI is missing/default.
# =============================================================================

# --- Application ---
APP_NAME="Service Marketplace"
APP_VERSION="0.1.0"

# Options: development | staging | production
# Controls: debug mode, API docs visibility, secret validation
ENVIRONMENT=development

# Enables detailed error responses and debug logging
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins
# Use ["*"] for development, restrict in production
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Middleware ---
# Trusted hosts — rejects requests with spoofed Host headers.
# Use ["*"] for development, your domain(s) for production.
TRUSTED_HOSTS=["*"]

# GZip — compress responses larger than this size (bytes)
GZIP_MINIMUM_SIZE=500

# Rate limiting (placeholder — requires Redis backend to activate)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Logging ---
# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG for development, INFO or WARNING for production
LOG_LEVEL=DEBUG

# Enable JSON structured logging + rotating log files (logs/app.log, logs/error.log)
# Set to true in production for log aggregator compatibility (ELK, CloudWatch, Datadog)
LOG_JSON_FORMAT=false

# --- Database (MongoDB Atlas) --- [SECRET]
# Get your connection string from MongoDB Atlas → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb+srv://yourally2026_db_user:BBXoVJRFiK1LPVOo@cluster0.qxwcjiv.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=ally

# Connection pool — Motor manages a pool of TCP connections to MongoDB.
# minPoolSize: pre-warmed connections (0 for dev, 5-10 for production)
# maxPoolSize: ceiling on concurrent connections (100 is Motor's default)
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=100

# --- JWT Authentication --- [SECRET]
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=kaamsetu
JWT_AUDIENCE=kaamsetu-api

# --- Password Security ---
# Bcrypt work factor: 12 for production (~250ms), 4 for testing
# BCRYPT_ROUNDS=12

# --- Cloudinary (Image/File Uploads) --- [SECRET]
# Get credentials from Cloudinary Dashboard → Account Details
# Uncomment when building the uploads module.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Firebase (Push Notifications) ---
# Path to your Firebase service account JSON file
# Uncomment when building the notifications module.
# FIREBASE_CREDENTIALS_PATH=
